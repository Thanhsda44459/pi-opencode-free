{
  "name": "pi-zen-free",
  "version": "1.0.0",
  "description": "Native Pi extension for OpenCode Zen anonymous free models (no API key required)",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "zen-free",
    "opencode",
    "opencode-zen",
    "free-models"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-ai": "^1.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
